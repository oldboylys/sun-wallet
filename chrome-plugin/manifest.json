{
  "manifest_version": 3,
  "name": "SUN Wallet",
  "version": "1.0.0",
  "description": "SUN Wallet is a simple and secure wallet for the Sun network.（以太链钱包）",
  "action": {
    "default_title": "SUN Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "idle", "sidePanel", "windows"]
}
